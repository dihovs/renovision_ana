# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Get an API key at https://platform.claude.com/settings/keys — powers the
# Vision AI chat widget's conversational replies and price estimates.
# Without this set, the chat widget will show a friendly error instead of chatting.
ANTHROPIC_API_KEY=

# Get a free API key at https://resend.com — used to email new leads (contact form + chat estimate tool)
RESEND_API_KEY=

# Optional: verified sending address once your domain is added in Resend.
# Until then, leave unset and it falls back to Resend's onboarding@resend.dev test sender.
# LEADS_FROM_EMAIL="Renovision AnA Leads <leads@renovisionana.ca>"

# Get an API key at https://console.cloud.google.com — enable "Distance Matrix API"
# and billing on the project. Powers the handyman calculator's postal-code trip fee
# (distance + live traffic from your shop address). Without this set, the calculator
# simply skips the trip fee.
#
# Also enable "Places API (New)" on the same project/key to power the homepage's
# five-star Google reviews pull (weekly refresh) and the real aggregate rating in
# the site's structured data. Without it, the site just uses its static testimonials.
GOOGLE_MAPS_API_KEY=


# ---------------------------------------------------------------------------
# Database — the CRM, transcripts, and stored leads
# ---------------------------------------------------------------------------
# From the Supabase project's Settings → API. The service-role key bypasses row
# level security, so it is server-only: never expose it to the browser and never
# prefix either of these with NEXT_PUBLIC_.
# Unset, the public site still works and /admin shows "no database connected".
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# The single shared password for /admin. Unset, the admin area refuses to sign
# anyone in rather than defaulting open. Pick something long; there is no
# rate limiting in front of it.
ADMIN_PASSWORD=

# Shared secret for the Vercel Cron routes (/api/cron/followups, /api/cron/retention).
# Vercel sends it as `Authorization: Bearer <value>`. Unset, those routes refuse
# every request — they are public URLs otherwise.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Phone — Ana, the voice agent
# ---------------------------------------------------------------------------
# From the Twilio console. Used to verify that inbound webhooks really came from
# Twilio (/api/voice/incoming, /api/voice/turn, /api/voice/status — the
# turn-based rollback path). Unset, those routes reject everything.
TWILIO_AUTH_TOKEN=

# ElevenLabs Agents — the live path. Three different secrets because they guard
# three different webhooks; see Docs/Voice-ElevenLabs-Setup.md.
#   init      — conversation-initiation webhook (/api/voice/el/init)
#   custom_llm— the per-turn LLM endpoint (/api/voice/el/chat), sent as a bearer token
#   postcall  — the end-of-call webhook (/api/voice/el/completed)
# Each is set in the ElevenLabs dashboard and must match here exactly.
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_CUSTOM_LLM_SECRET=
ELEVENLABS_POSTCALL_WEBHOOK_SECRET=

# Owner mode — Ana answering questions about the CRM when the owner calls.
#
# TWO FACTORS, BOTH REQUIRED. The call has to come from a number on the list AND
# the caller has to speak the PIN. Neither is strong on its own: caller ID is
# trivially spoofable, and a PIN said out loud can be overheard. Requiring both
# means an attacker needs the right number *and* the code.
#
# Even then it only unlocks READING the CRM plus dictating a note — nothing in
# owner mode sends a message, edits a record, moves money, or changes the site.
#
# Leave either one blank and owner mode does not exist: Ana treats every caller,
# including the owner, as an ordinary customer. That is the intended default.
#
#   OWNER_PHONE_NUMBERS — comma-separated. Any format; only the last ten digits
#                         are compared, so "+15551234567" and "(555) 123-4567"
#                         both match the same line.
#   OWNER_VOICE_PIN     — digits only, at least four. Six or more is better; it
#                         is spoken aloud, so pick something that isn't a
#                         birthday and change it if it is ever overheard.
OWNER_PHONE_NUMBERS=+15551234567
OWNER_VOICE_PIN=

# ---------------------------------------------------------------------------
# WhatsApp — subcontractor photos into the job inbox
# ---------------------------------------------------------------------------
# From the Meta app dashboard (WhatsApp Business Platform).
#   VERIFY_TOKEN — any string you choose; Meta echoes it back when you register
#                  the webhook URL, and it must match.
#   APP_SECRET   — signs every delivery; unset, the webhook rejects everything.
#   ACCESS_TOKEN — used to download the media Meta only gives us a handle for.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Local tooling
# ---------------------------------------------------------------------------
# Optional. Where `npm run leads:export` writes its CSV. Defaults to ./exports.
# LEADS_EXPORT_DIR=./exports
