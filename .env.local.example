# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Get an API key at https://platform.claude.com/settings/keys — powers the
# Vision AI chat widget's conversational replies and price estimates.
# Without this set, the chat widget will show a friendly error instead of chatting.
ANTHROPIC_API_KEY=

# Get a free API key at https://resend.com — used to email new leads (contact form + chat estimate tool)
RESEND_API_KEY=

# Optional: verified sending address once your domain is added in Resend.
# Until then, leave unset and it falls back to Resend's onboarding@resend.dev test sender.
# LEADS_FROM_EMAIL="Renovision AnA Leads <leads@renovisionana.ca>"

# Get an API key at https://console.cloud.google.com — enable "Distance Matrix API"
# and billing on the project. Powers the handyman calculator's postal-code trip fee
# (distance + live traffic from your shop address). Without this set, the calculator
# simply skips the trip fee.
#
# Also enable "Places API (New)" on the same project/key to power the homepage's
# five-star Google reviews pull (weekly refresh) and the real aggregate rating in
# the site's structured data. Without it, the site just uses its static testimonials.
GOOGLE_MAPS_API_KEY=

# Google Search Console ownership. Create the property at
# https://search.google.com/search-console (URL-prefix type,
# https://www.renovisionana.ca), choose "HTML tag" verification, and paste the
# content="..." value here — just the token, not the whole tag. Redeploy, then
# click Verify. The token is not a secret (it is printed into every page's
# <head> by design), which is why NEXT_PUBLIC_ is safe here and nowhere else in
# this file. Unset, no tag renders and nothing else changes.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=


# ---------------------------------------------------------------------------
# Database — the CRM, transcripts, and stored leads
# ---------------------------------------------------------------------------
# From the Supabase project's Settings → API. The service-role key bypasses row
# level security, so it is server-only: never expose it to the browser and never
# prefix either of these with NEXT_PUBLIC_.
# Unset, the public site still works and /admin shows "no database connected".
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# The single shared password for /admin. Unset, the admin area refuses to sign
# anyone in rather than defaulting open. Pick something long; there is no
# rate limiting in front of it.
ADMIN_PASSWORD=

# Shared secret for the Vercel Cron routes (/api/cron/followups, /api/cron/retention,
# /api/cron/outbound). Vercel sends it as `Authorization: Bearer <value>`. Unset,
# those routes refuse every request — they are public URLs otherwise, and one of
# them telephones customers.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Phone — Ana, the voice agent
# ---------------------------------------------------------------------------
# From the Twilio console. Used to verify that inbound webhooks really came from
# Twilio. TWILIO_AUTH_TOKEN signs the inbound webhooks (/api/voice/incoming,
# /api/voice/turn, /api/voice/status — the turn-based rollback path — and
# /api/sms/incoming); unset, those routes reject everything.
#
# TWILIO_ACCOUNT_SID is needed to SEND text messages. It is an account
# identifier rather than a secret — it is visible on every page of the Twilio
# console — but it lives here because the sending path needs both halves of the
# HTTP Basic pair. Without it, texting is off and the admin says so instead of
# failing silently.
#
# SMS_FROM_NUMBER is optional: unset, texts go out from SITE_PHONE_TEL, which
# is the number customers already know.
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
SMS_FROM_NUMBER=

# Which phone rings when the owner presses "Call as business" in the admin.
# Optional: unset, it uses the first entry of OWNER_PHONE_NUMBERS, so the
# number is configured once and means the same thing in both places. Set it
# only to have CRM calls land somewhere other than the line he authenticates
# owner mode from.

# ElevenLabs Agents — the live path. Three different secrets because they guard
# three different webhooks; see Docs/Voice-ElevenLabs-Setup.md.
#   init      — conversation-initiation webhook (/api/voice/el/init)
#   custom_llm— the per-turn LLM endpoint (/api/voice/el/chat), sent as a bearer token
#   postcall  — the end-of-call webhook (/api/voice/el/completed)
# Each is set in the ElevenLabs dashboard and must match here exactly.
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_CUSTOM_LLM_SECRET=
ELEVENLABS_POSTCALL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Outbound calls — Ana placing the call rather than answering it
# ---------------------------------------------------------------------------
# Three credentials for /api/cron/outbound. Unset ANY of them and the dialer
# refuses to place a call and says so in the logs — it never half-works. The
# queue keeps filling; nothing is lost, nothing is dialled.
#
# Only ever used for the three notification kinds in migration 0018
# (confirm_visit, crew_on_way, schedule_change). See
# Docs/Voice-Outbound-Compliance.md for why that boundary is legal, not
# stylistic.
#
#   ELEVENLABS_API_KEY
#     From the ElevenLabs dashboard, Profile → API keys. This is the first
#     credential in this project that can spend money and make a stranger's
#     phone ring — scope it as narrowly as the dashboard allows, and rotate it
#     rather than sharing it. It is never written to a log.
#
#   ELEVENLABS_OUTBOUND_AGENT_ID
#     The agent that places the call. Docs/Voice-Outbound-Research.md §3
#     recommends a SECOND agent for outbound ("Ana — appels sortants") with its
#     own analysis fields, voicemail detection, and no conversation-initiation
#     webhook. If you create one, put ITS id here — not the inbound
#     receptionist's, which would open outbound calls with "how may I help you?"
#
#   ELEVENLABS_PHONE_NUMBER_ID
#     NOT the phone number. The `phone_number_id` field from
#     `GET https://api.elevenlabs.io/v1/convai/phone-numbers` (send the API key
#     as an `xi-api-key` header) for our imported Twilio number. Stable FOR A
#     GIVEN NUMBER (set once, no per-call lookup) — but swapping the Twilio
#     number mints a brand-new id, so re-fetch this after any number change.
#     A stale id fails silently: inbound keeps working (it never reads this),
#     outbound just stops dialing. Confirm `supports_outbound: true` on that
#     row before expecting anything to dial.
ELEVENLABS_API_KEY=
ELEVENLABS_OUTBOUND_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Owner mode — Ana answering questions about the CRM when the owner calls.
#
# TWO FACTORS, BOTH REQUIRED. The call has to come from a number on the list AND
# the caller has to speak the PIN. Neither is strong on its own: caller ID is
# trivially spoofable, and a PIN said out loud can be overheard. Requiring both
# means an attacker needs the right number *and* the code.
#
# Even then it only unlocks READING the CRM plus dictating a note — nothing in
# owner mode sends a message, edits a record, moves money, or changes the site.
#
# Leave either one blank and owner mode does not exist: Ana treats every caller,
# including the owner, as an ordinary customer. That is the intended default.
#
#   OWNER_PHONE_NUMBERS — comma-separated. Any format; only the last ten digits
#                         are compared, so "+15551234567" and "(555) 123-4567"
#                         both match the same line.
#   OWNER_VOICE_PIN     — digits only, at least four. Six or more is better; it
#                         is spoken aloud, so pick something that isn't a
#                         birthday and change it if it is ever overheard.
OWNER_PHONE_NUMBERS=+15551234567
OWNER_VOICE_PIN=

# ---------------------------------------------------------------------------
# WhatsApp — subcontractor photos into the job inbox
# ---------------------------------------------------------------------------
# From the Meta app dashboard (WhatsApp Business Platform).
#   VERIFY_TOKEN — any string you choose; Meta echoes it back when you register
#                  the webhook URL, and it must match.
#   APP_SECRET   — signs every delivery; unset, the webhook rejects everything.
#   ACCESS_TOKEN — used to download the media Meta only gives us a handle for.
#   ACCESS_TOKEN also SENDS, and for that it must be a permanent System User
#                  token (Business Settings -> Users -> System Users), not the
#                  24-hour test token the dashboard offers first. A test token
#                  works for a day and then dispatch fails with code 190.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

# The numeric Phone number ID from WhatsApp Manager -> API Setup. NOT the phone
# number itself. Unset, nothing can be sent; inbound still works.
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Account ID, from the same screen. Only needed to manage
# message templates over the API — the owner creates them in the console, so
# this is optional today.
WHATSAPP_WABA_ID=

# Where crew links point. This is baked into the approved template's button, so
# changing it means re-approving both templates: it is config, not a constant.
CREW_LINK_BASE_URL=https://www.renovisionana.ca/crew

# ---------------------------------------------------------------------------
# Local tooling
# ---------------------------------------------------------------------------
# Optional. Where `npm run leads:export` writes its CSV. Defaults to ./exports.
# LEADS_EXPORT_DIR=./exports

OWNER_MOBILE=

# Calling customers from the browser, in the admin (/admin/calls). The Access
# Token handed to the browser is signed with an API Key rather than the account
# credentials, so a leaked token grants one capability — place outgoing calls
# through the TwiML app below — and expires within the hour.
#
# Create the API Key under Account > API keys & tokens (Standard). The secret
# is shown once. Create the TwiML App under Voice > TwiML > TwiML Apps, and set
# its Voice Request URL to https://www.renovisionana.ca/api/voice/softphone
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# ---------------------------------------------------------------------------
# Microsoft Graph — Ana reading Teams chats, Outlook mail and OneDrive files
# ---------------------------------------------------------------------------
# From the Entra ID app registration (see Docs/Microsoft-Graph-Setup.md for the
# exact clicks). Delegated access as the owner: his Teams, his mail, his files.
# Voice calls are deliberately never requested — src/lib/microsoft/scopes.ts is
# the boundary and scopes.test.ts keeps it true.
#
# Directory (tenant) ID and Application (client) ID, from the registration's
# Overview page.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# Certificates & secrets → New client secret. Copy the VALUE column immediately
# — it is shown once. Expires in 6–24 months; when it does, /admin shows the
# connection as needing consent and a new secret goes here.
MICROSOFT_CLIENT_SECRET=
# Encrypts the stored refresh token at rest (AES-256-GCM). Generate with:
#   openssl rand -hex 32
# Losing it means reconnecting Microsoft once; leaking it means nothing by
# itself, since the ciphertext also has to be stolen from the database.
MICROSOFT_TOKEN_KEY=
# Only needed when testing the consent flow somewhere other than production,
# e.g. http://localhost:3000/api/v1/microsoft/callback. Must exactly match a
# Redirect URI on the app registration. Defaults to the production callback.
# MICROSOFT_REDIRECT_URI=
